# Copy to .env and fill secrets. Do NOT commit .env (gitignored).

KALEIDO_HOST=127.0.0.1
KALEIDO_PORT=18766
KALEIDO_DATA=./data

# Bootstrap admin (only used when $KALEIDO_DATA/state/users.json is empty)
KALEIDO_ADMIN_USER=admin
KALEIDO_ADMIN_PASSWORD=change-me-strong-password

# Session / rate limits
KALEIDO_SESSION_TTL_HOURS=12
KALEIDO_LOGIN_MAX_ATTEMPTS=10
KALEIDO_LOGIN_WINDOW_SECS=300
KALEIDO_MAX_SESSIONS=50
KALEIDO_MAX_CONCURRENT_JOBS=2

# OpenAI-compatible LLM
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
KALEIDO_LLM_PROVIDER=OpenAI

# Embeddings
KALEIDO_EMBED_INLINE=1
KALEIDO_EMBED_CACHE=./data/embed-cache
EMBEDDING_BASE_URL=http://127.0.0.1:20145

RUST_LOG=kaleido_server=info,kaleido_core=info
