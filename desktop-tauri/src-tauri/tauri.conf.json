{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaleido",
  "mainBinaryName": "kaleido-desktop",
  "version": "0.1.0",
  "identifier": "io.github.kaleido.desktop",
  "build": {
    "frontendDist": "../web-stub"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaleido · 沉浸叙事工作台",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png"
    ]
  }
}
